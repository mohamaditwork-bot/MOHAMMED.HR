{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novotel-madinah-hr",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "HR", "id": "REPLACE_WITH_KV_ID" }
  ],
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`): SESSION_SECRET, HR_USERS_SEED
}
